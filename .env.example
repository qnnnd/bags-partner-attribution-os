# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bags_attribution

# ─── Bags Client ─────────────────────────────────────────────────────────────
# Set to "mock" for local development and CI (default)
# Set to "mainnet-readonly" for real Bags data (requires BAGS_API_KEY + SOLANA_RPC_URL)
BAGS_CLIENT_MODE=mock

# Required for mainnet-readonly mode. Obtain from the Bags developer portal.
BAGS_API_KEY=your_bags_api_key_here

# Bags API base URL (default: https://api.bags.fm)
BAGS_API_BASE=https://api.bags.fm

# Solana network (mainnet-beta for real data)
BAGS_NETWORK=mainnet-beta

# ─── Solana ───────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ─── Phase 2: Fixture Fallback ────────────────────────────────────────────────
# Set to "true" to always use demo fixture data instead of hitting Bags API
# Useful for: offline demos, testing, CI when mainnet-readonly is needed
BAGS_ENABLE_FIXTURE_FALLBACK=false

# ─── Safety Guard ─────────────────────────────────────────────────────────────
# Must remain "false" in development and CI. Only set true for manual mainnet scripts.
ENABLE_MAINNET_WRITE=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
SESSION_SECRET=change_me_to_at_least_32_random_characters
HASH_SALT=change_me_to_a_random_salt_string

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_SEED_ENABLED=true
