{
  "name": "bags-partner-attribution-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate --filter=@bags/db",
    "db:studio": "turbo run db:studio --filter=@bags/db",
    "seed:demo": "dotenv -e .env -- tsx scripts/seed-demo.ts",
    "e2e": "turbo run e2e --filter=@bags/web"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "tsx": "^4.19.2",
    "turbo": "^2.5.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
